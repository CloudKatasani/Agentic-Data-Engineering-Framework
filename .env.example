# Copy to .env (never commit it).
# Encryption key for the secret vault. If unset, a key file is generated in ADEF_HOME.
ADEF_MASTER_KEY=
# Require this bearer token for the API and console (strongly recommended for shared demos).
ADEF_API_TOKEN=
# Where settings, the encrypted vault and run workspaces live (default ./data).
ADEF_HOME=
