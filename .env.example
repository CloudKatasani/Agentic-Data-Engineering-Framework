# Copy to .env and chmod 600 it. Never commit .env.

# --- Required when ADEF listens beyond localhost (Docker, EC2): the console/API bearer token.
#     Generate:  openssl rand -hex 24
ADEF_API_TOKEN=

# --- Encryption key for keys you add in the console's vault. Generate:
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADEF_MASTER_KEY=

# --- Model provider keys: set any you have. The agent team is chosen from what is present
#     (only Anthropic -> all-Claude, only OpenAI -> all-OpenAI, several -> multi-vendor).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
OLLAMA_BASE_URL=
# Optional: force a team preset (multi-vendor, all-claude, all-openai, all-gemini, cost-optimized, simulator)
ADEF_TEAM_PRESET=
# Wall-clock limit for one model call, in seconds (default 600). A stage that exceeds it falls back to the Demo Simulator.
ADEF_MODEL_TIMEOUT_SECONDS=

# --- Optional synthetic source databases (docker compose --profile oracle / --profile db2)
ORACLE_PASSWORD=
DB2_PASSWORD=
WITH_DB2=false

# --- Optional HTTPS (docker compose --profile https)
DOMAIN=

# Name and tagline shown in the console header (defaults: DataCrew AI / Agentic Data Engineering).
ADEF_BRAND_NAME=
ADEF_BRAND_TAGLINE=
