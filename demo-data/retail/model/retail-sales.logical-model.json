  "metrics": [
    {
      "name": "net_sales",
      "label": "Net sales",
      "entity": "sales_line",
      "measure": {
        "agg": "sum",
        "attribute": "net_amount"
      },
      "denominator": null,
      "unit": "currency",
      "business_rule": "BR-001",
      "grain": "day",
      "definition": "Gross sales less discounts and returns."
    },
    {
      "name": "average_order_value",
      "label": "Average order value",
      "entity": "sales_line",
      "measure": {
        "agg": "sum",
        "attribute": "net_amount"
      },
      "denominator": {
        "agg": "count_distinct",
        "attribute": "order_id"
      },
      "unit": "currency",
      "business_rule": "BR-002",
      "grain": "day",
      "definition": "Net sales divided by distinct orders."
    }
