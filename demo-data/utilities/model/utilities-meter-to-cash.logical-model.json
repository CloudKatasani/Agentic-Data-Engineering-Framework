    {
      "name": "billed_consumption",
      "kind": "fact",
      "history": "none",
      "grain": "one row per final bill",
      "description": "Billed versus metered consumption per bill",
      "subject_area": "billing",
      "attributes": [
        {
          "name": "bill_id",
          "type": "string(20)",
          "pk": true,
          "fk": null,
          "classification": "internal",
          "description": "Business key of the bill",
          "business_rule": null,
          "req_ids": [
            "REQ-001"
          ],
          "nullable": false,
          "label": "Bill Id"
        },
        {
          "name": "customer_account_id",
          "type": "string(20)",
          "pk": false,
          "fk": {
            "entity": "customer_account",
            "attribute": "customer_account_id"
          },
          "classification": "internal",
          "description": "Billed account",
          "business_rule": null,
          "req_ids": [
            "REQ-001"
          ],
          "nullable": true,
          "label": "Customer Account Id"
        },
        {
          "name": "bill_period_start",
          "type": "date",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "First day of bill period",
          "business_rule": null,
          "req_ids": [
            "REQ-001"
          ],
          "nullable": true,
          "label": "Bill Period Start"
        },
        {
          "name": "bill_period_end",
          "type": "date",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "Last day of bill period",
