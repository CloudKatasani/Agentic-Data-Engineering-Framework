          "name": "billed_kwh",
          "type": "decimal(18,3)",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "kWh on the bill",
          "business_rule": "BR-003",
          "req_ids": [
            "REQ-001"
          ],
          "nullable": true,
          "label": "Billed Kwh"
        },
        {
          "name": "metered_kwh",
          "type": "decimal(18,3)",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "Metered kWh in the bill period",
          "business_rule": "BR-001",
          "req_ids": [
            "REQ-002"
          ],
          "nullable": true,
          "label": "Metered Kwh"
        },
        {
          "name": "estimated_read_share",
          "type": "decimal(5,4)",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "Share of estimated reads",
          "business_rule": "BR-002",
          "req_ids": [
            "REQ-003"
          ],
          "nullable": true,
          "label": "Estimated Read Share"
        },
        {
          "name": "variance_kwh",
          "type": "decimal(18,3)",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "Billed minus metered kWh",
          "business_rule": "BR-004",
          "req_ids": [
            "REQ-002"
          ],
          "nullable": true,
          "label": "Variance Kwh"
        },
        {
          "name": "amount_due",
          "type": "decimal(18,2)",
          "pk": false,
          "fk": null,
          "classification": "internal",
          "description": "Amount billed",
          "business_rule": null,
          "req_ids": [
            "REQ-006"
          ],
          "nullable": true,
          "label": "Amount Due"
        }
      ],
      "label": "Billed Consumption"
    }
  ],
  "metrics": [
    {
      "name": "avg_billed_kwh_per_account",
      "label": "Average billed kWh per account",
      "entity": "billed_consumption",
      "measure": {
        "agg": "sum",
        "attribute": "billed_kwh"
      },
      "denominator": {
        "agg": "count_distinct",
        "attribute": "customer_account_id"
      },
      "unit": "kWh",
      "business_rule": "BR-001",
      "grain": "month",
      "definition": "Total billed kWh divided by number of distinct billed accounts in the period."
    },
    {
      "name": "total_billed_kwh",
      "label": "Total billed kWh",
      "entity": "billed_consumption",
      "measure": {
        "agg": "sum",
        "attribute": "billed_kwh"
      },
      "denominator": null,
      "unit": "kWh",
      "business_rule": "BR-003",
      "grain": "month",
      "definition": "Sum of billed kWh on final bills."
    }
  ],
  "description": "Meter-to-cash billed consumption data product"
}