      "id": "10000",
      "key": "UTIL-1",
      "self": "https://demo-utilities.atlassian.net/rest/api/3/issue/10000",
      "fields": {
        "summary": "Meter-to-cash billed consumption data product",
        "issuetype": {
          "name": "Epic"
        },
        "status": {
          "name": "In Progress"
        },
        "priority": {
          "name": "High"
        },
        "labels": [
          "data-product",
          "utilities"
        ],
        "parent": null,
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Finance and Customer Operations need a trusted monthly view of billed versus metered consumption per customer account, so they can find billing leakage and track estimated reads. Start with residential accounts in one region; reconcile to the monthly revenue report."
                }
              ]
            }
          ]
        },
        "customfield_10035": null
      }
    },
    {
      "id": "10001",
      "key": "UTIL-2",
      "self": "https://demo-utilities.atlassian.net/rest/api/3/issue/10001",
      "fields": {
        "summary": "Provide one row per final bill with account, bill period and billed kWh.",
        "issuetype": {
          "name": "Story"
        },
        "status": {
          "name": "To Do"
        },
        "priority": {
          "name": "High"
        },
        "labels": [
          "adpe"
        ],
        "parent": {
          "key": "UTIL-1"
        },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As the Revenue Assurance analysts, I need this so I can answer: \"Where is billed consumption below metered consumption?\""
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Acceptance criteria"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Given a final bill exists in the source, when the data product is refreshed, then one row exists for that bill with matching billed kWh."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "customfield_10035": "Given a final bill exists in the source, when the data product is refreshed, then one row exists for that bill with matching billed kWh."
      }
    },
    {
      "id": "10002",
      "key": "UTIL-3",
      "self": "https://demo-utilities.atlassian.net/rest/api/3/issue/10002",
      "fields": {
        "summary": "Compare billed kWh with metered kWh for the same bill period and expose the variance.",
        "issuetype": {
          "name": "Story"
        },
        "status": {
          "name": "To Do"
        },
        "priority": {
          "name": "High"
        },
        "labels": [
          "adpe"
        ],
        "parent": {
          "key": "UTIL-1"
        },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As the Customer Operations lead, I need this so I can answer: \"What share of bills rely on estimated reads?\""
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Acceptance criteria"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Given daily reads exist for the account's meters in the bill period, when the bill is loaded, then metered kWh equals the sum of those reads and variance equals billed minus metered."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "customfield_10035": "Given daily reads exist for the account's meters in the bill period, when the bill is loaded, then metered kWh equals the sum of those reads and variance equals billed minus metered."
      }
    },
    {
      "id": "10003",
      "key": "UTIL-4",
      "self": "https://demo-utilities.atlassian.net/rest/api/3/issue/10003",
      "fields": {
        "summary": "Show the share of estimated reads behind each bill.",
        "issuetype": {
          "name": "Story"
        },
        "status": {
          "name": "To Do"
        },
        "priority": {
          "name": "Medium"
        },
        "labels": [
          "adpe"
        ],
        "parent": {
          "key": "UTIL-1"
        },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As the Finance controller, I need this so I can answer: \"Does billed kWh reconcile to the monthly revenue report?\""
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Acceptance criteria"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Given a bill period includes estimated reads, when the bill is loaded, then estimated read share equals estimated reads divided by all reads."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "customfield_10035": "Given a bill period includes estimated reads, when the bill is loaded, then estimated read share equals estimated reads divided by all reads."
      }
    },
